# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
**/__pycache__/*

# Auto-generated by clockwise component (now in build tree: .esphome/build/**/src/esphome/components/clockwise/)
components/clockwise/clockface_wrapper_*.cpp
components/clockwise/clockface_registry.cpp
components/clockwise/clockface_registry.h